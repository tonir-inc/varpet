# Scene database shared by the web app and every scene MCP process (Pascal SQLite store).
PASCAL_DB_PATH=./.data/pascal.db
# Accounts, developers, shares.
VARPET_DATA_DIR=./.data
# Catalog service (Python, runs on the VM). MCP at /mcp, models at /models.
VARPET_CATALOG_URL=http://100.107.246.46:8765
# Public origin for GLB and thumbnail URLs the browser loads.
VARPET_PUBLIC_ORIGIN=http://localhost:3010
# proposal (agent edits a copy, person applies) or direct (agent edits the live scene).
VARPET_AGENT_EDITS=proposal
# Agents run `claude -p` on Felix's subscription. On a server: `claude setup-token`, then set this.
CLAUDE_CODE_OAUTH_TOKEN=
