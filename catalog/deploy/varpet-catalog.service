[Unit]
Description=varpet furniture catalog MCP server (HTTP on the tailnet only)
After=network-online.target postgresql.service tailscaled.service
Wants=network-online.target

[Service]
User=varpet-catalog
Group=varpet-catalog
WorkingDirectory=/opt/varpet-catalog/app
EnvironmentFile=/etc/varpet-catalog.env
ExecStart=/opt/varpet-catalog/app/.venv/bin/python mcp_server.py
TimeoutStopSec=10
Restart=always
RestartSec=2
# Shared box (a Minecraft server and other apps): cap what we can take.
MemoryHigh=1700M
MemoryMax=2G
CPUQuota=200%
Nice=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/varpet-catalog
PrivateTmp=true

[Install]
WantedBy=multi-user.target
