node_modules/
dist/
.venv/
__pycache__/
*.blend1
assets/build/
.DS_Store

# team agent config is committed (a global gitignore may hide .claude/); personal overrides stay local
!.claude/
!.claude/**
.claude/settings.local.json
catalog/data/
.env
.varpet/
catalog/eval/sheets/

# real-listing fixtures (copyrighted listing media, private testing only)
fixtures/real/

# procedural candidates: rebuild with catalog/texgen/gen.py
catalog/materials/*-gen/
catalog/texgen/contact.png

# replay media from real listings (copyrighted, local only)
apps/editor/public/architect-replay/

# Designer eval runs: raw transcripts, captures and screenshots stay local (history and tag pre-folio-ui keep the old ones).
# Tracked: reports (*.md), what the showcase loads (komitas-runs/*/run.json, final.json) and what tests read.
packages/designer/eval/*-runs/**/*.*
packages/designer/eval/taste-komitas-results/*.tar.gz
!packages/designer/eval/*-runs/**/*.md
!packages/designer/eval/komitas-runs/*/run.json
!packages/designer/eval/komitas-runs/*/final.json
!packages/designer/eval/komitas-runs/avani-check/*
!packages/designer/eval/chain-runs/20260926/architect-browser.json
!packages/designer/eval/fast-runs/matrix-after-restored/*/initial.json
