[Unit]
Description=Varpet architect
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=varpet-app
Group=varpet-app
Slice=varpet-app.slice
WorkingDirectory=/opt/varpet-app/repo/harness
EnvironmentFile=/etc/varpet-app.env
Environment=HOME=/opt/varpet-app
Environment=PATH=/opt/varpet-app/repo/harness/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/varpet-app/repo/harness/.venv/bin/varpet-harness serve --port 8788 --runs /opt/varpet-app/runs
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
MemoryHigh=1536M
MemoryMax=2560M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/varpet-app/codex-home /opt/varpet-app/runs /opt/varpet-app/cache /tmp
UMask=0077

[Install]
WantedBy=multi-user.target
