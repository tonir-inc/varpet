{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/protect-contract.js\"", "statusMessage": "Checking the contract files" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/protect-contract.js\"", "statusMessage": "Checking the contract files" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/tests-on-stop.js\"", "timeout": 200 }
        ]
      }
    ]
  }
}
