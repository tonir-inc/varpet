{
  "name": "@varpet/designer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/adapter.ts"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "vitest run && python3 -m unittest discover -s ../../harness -p 'designer*_test.py' && python3 -m unittest discover -s eval -p 'test_*.py' && python3 -m unittest discover -s spike/run -p '*_test.py'",
    "eval": "python3 eval/run.py",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.3",
    "pnpm": "10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
