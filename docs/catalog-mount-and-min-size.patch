 def _minmax(x):
     lo, hi = x.min(), x.max()
     return (x - lo) / (hi - lo) if hi > lo else np.zeros_like(x)
+
+
+_PLACEMENT_MOUNT = {"floor": "floor", "surface": "surface", "wall": "wall", "wall-mounted": "wall",
+                   "ceiling": "ceiling", "ceiling-mounted": "ceiling"}
+_WALL_WORDS = re.compile(r"\bsconces?\b|\bwall[- ]?(mount(ed)?|hung|light|lamp|fixture|shel(f|ves)|cabinet|clock|decor|hanging)\b|\bfloating shel", re.I)
+_CEILING_WORDS = re.compile(r"\bpendants?\b|\bchandeliers?\b|\bceiling\b|\bflush[- ]?mount", re.I)
+_NOTE_MOUNT = re.compile(r"^(wall-mounted|wall-hung|ceiling)([^a-zA-Z0-9_]|$)", re.I)
+
+
+def mount_of(kind, name, tags, size):
+    """How an item goes up: floor | surface | wall | ceiling. The explicit placement tag, then mounting notes, then
+    kind and name (Amazon items have neither tag nor notes). Same rules as varpet v2's scene MCP (mount.ts)."""
+    extra = (tags or {}).get("extra") or {}
+    placement = _PLACEMENT_MOUNT.get(str(extra.get("placement") or "").strip().lower())
+    if placement:
+        return placement
+    note = _NOTE_MOUNT.match(str(extra.get("notes") or ""))
+    if note:
+        return "ceiling" if note.group(1).lower() == "ceiling" else "wall"
+    name, height = name or "", (size or [0, 0, 1])[2]
+    if kind in ("wall_art", "wall_hanging", "curtain", "blind", "radiator"):
+        return "wall"
+    if kind == "light":
+        return "wall" if _WALL_WORDS.search(name) else "floor" if re.search(r"\bfloor lamp", name, re.I) else "ceiling"
+    if kind == "lamp":
+        if _WALL_WORDS.search(name):
+            return "wall"
+        if _CEILING_WORDS.search(name):
+            return "ceiling"
+        return "floor" if re.search(r"\bfloor\b", name, re.I) or height >= 1 else "surface"
+    if kind == "mirror":
+        return "floor" if re.search(r"\bfloor\b|\bstanding\b|full[- ]length|\blean(er|ing)\b|\bcheval\b", name, re.I) else "wall"
+    if kind == "clock":
+        return "surface" if re.search(r"\b(table|desk|mantel|alarm|shelf) clock", name, re.I) else "wall"
+    if kind == "fan":
+        return "ceiling" if _CEILING_WORDS.search(name) else "floor"
+    if kind in ("tv", "decor", "laptop", "computer", "monitor", "printer", "game_console", "microwave", "speaker"):
+        return "surface"
+    if kind == "plant":
+        return "floor" if height >= 0.6 else "surface"
+    return "wall" if _WALL_WORDS.search(name) else "floor"
 
 
